# Server
PORT=3000

# MongoDB — use your connection string
# Local:  mongodb://localhost:27017/expiry_tracker
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/expiry_tracker
MONGODB_URI=mongodb://localhost:27017/expiry_tracker

# JWT — use a long, random secret in production (e.g. openssl rand -base64 64)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Upload limits
MAX_FILE_SIZE_MB=5

# ── OCR.space API ─────────────────────────────────────────────────────────────
# Get a free API key at https://ocr.space/ocrapi
OCR_SPACE_API_KEY=your_ocr_space_api_key

# ── Cloudinary Configuration ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


